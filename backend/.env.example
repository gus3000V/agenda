PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/agenda
# Set a long, unique administrator password. Never expose it as a VITE variable.
ADMIN_PIN=
CRON_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Only for local PostgreSQL without TLS. In production use verify-full.
PGSSLMODE=disable
# Set only to the actual number of trusted reverse proxies in your deployment.
# TRUST_PROXY_HOPS=1
# PGSSLROOTCERT_PEM=
